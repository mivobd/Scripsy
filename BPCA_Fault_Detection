# PCA stats for the chosen principal components
x = x.T
P = W[:, :k] # principal subspace
M = P.T @ P + I_K / beta
S_var_tx_inv = beta*M
t = P.T @ np.linalg.solve( P @ P.T + I_D / beta, x ) # score matrix for BPCA
xbar = P @ t
e = x - xbar # shape(t) = (m, n), residuals or error, inter alia

stats.Q_tr = np.sum( e**2, axis=0 )
stats.meanQ_tr = np.mean( stats.Q_tr )
stats.varQ_tr = np.var( stats.Q_tr, ddof=1 )
g = stats.varQ_tr / ( 2*stats.meanQ_tr )
h = stats.meanQ_tr / g

# Similarity checks
L = P
stats.tsquared95 = chi2.ppf(1-lim, k) # Bayesian PCA version of 95 % confidence limit for Hotelling's T-squared 
stats.Q95 = g*chi2.ppf(1-lim, h) # Bayesian PCA version of 95 % confidence limit for the Q statistic
stats.r95 = binom.ppf(1-lim, 1024, lim) # hardcoding the number of expected measurements... surely this will not bite me in the ass later...
stats.S_pcaBest = 0.965 # Johannesmeyer provided best value


if show_snapshot_Tsquared == True:
    tsquared = np.zeros(num.recorded_points)
    for column in range(0, num.recorded_points):
        tsquared[column] = (t[:, column].reshape(-1, 1).T @ S_var_tx_inv @ t[:, column])[0]


    fig2, ax2 = plt.subplots(1, 1, layout='constrained')
    ax2.plot(np.linspace(1, num.recorded_points, num.recorded_points), stats.tsquared95*np.ones(num.recorded_points), color = 'r', linestyle = '--', label = "95% confidence limit")
    ax2.plot(np.linspace(1, num.recorded_points, num.recorded_points), tsquared, color = 'k', linestyle = '-', label = "Hotelling's T-squared statistic")
    ax2.set_xlabel("Observation")
    ax2.set_ylabel("Hotelling's T-squared statistic")
    ax2.legend(loc = 'upper left')
    plt.show()


