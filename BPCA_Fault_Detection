num = SimpleNamespace() # storing various useful numbers
stats = SimpleNamespace()
# Simulation results
data = SimpleNamespace()
data.snapshot = SimpleNamespace() # dedicated to snapshot-related values
simulation_path = f"simulation_data/C{control}_AR{autoregressive_noise}_M{measurement_noise}"
with open(f"{simulation_path}/OldSnapshot_{snapshot}.json", 'r', encoding='utf-8') as file:
    data.results = json.load(file) # results = (keys: string), (values: 1x1 cell array: 1024x1 cell)
stats.snapshot_fault = ''.join(chr(ii) for ii in (int(jj) for jj in data.results["fault"]))
data.t = data.results["t"]
data.dt = data.t[1] - data.t[0]
num.ignore = int(data.results["fault time"] / data.dt) # the number of measurements that will be ignored (corresponding to the period of NOC before the disturbance)


# Simulation data preparation
num.measurements = len(data.t) - num.ignore # the number of measurements that will be used for PCA (corresponding to the period after the disturbance)
num.recorded_points = len(data.results["t"])
data.measured_variables = data.results["measurements"]
data.measured_variables.remove("t") # the measurement times are not being considered for PCA, removing it here saves effort later
num.variables = len(data.measured_variables); # the number of variables that will be in the matrix we perform PCA on
data.set = np.zeros([num.recorded_points, num.variables]) # initialising the matrix that will store the dataset used to perform PCA

# putting all the simulation data into one matrix
for ii in range(0, num.variables):
    data.set[:, ii] = data.results[data.measured_variables[ii]]
data.snapshot.mean = np.mean(data.set, axis=0)
x = (data.set-data.snapshot.mean) # scaling the data


# BPCA results
results = SimpleNamespace()
model_path = f"BPCA_models/C{control}_AR{autoregressive_noise}_M{measurement_noise}"
with open(f"{model_path}/OldSnapshot_{snapshot}_{total_searches}.json", 'r', encoding='utf-8') as file:        
        results.Snapshot = SimpleNamespace(**json.load(file)) # results = (keys: string), (values: 1x1 cell array: 1024x1 cell)


W_unordered = np.array(results.Snapshot.best_parameters[0])
alphas = np.array(results.Snapshot.best_parameters[2]).reshape(-1)
num.OGweights = len(alphas)
num.variables = np.shape(W_unordered)[0]
ordered_indices = np.argsort(1/alphas)
W = W_unordered[:, ordered_indices[::-1]]
alphas_ordered = alphas[ordered_indices[::-1]]
beta = results.Snapshot.best_parameters[1]


cum_explained = [np.sum(np.diag(1/alphas_ordered[:ii+1])) for ii in range(0, num.OGweights)]/np.sum(np.diag(1/alphas_ordered))
for ii in range(0, num.OGweights):
    if cum_explained[ii] > 0.95:
        k = ii+1
        break
retained = np.zeros((num.variables, num.OGweights))
for ii in range(0, k):
    retained[:, ii] = W[:, ii].reshape(14)

I_K = np.identity(k)
I_D = np.identity(num.variables)


if plot_PC_selection == True:
    # visualising the selection of retained number of principal components
    weight_nums = np.linspace(1, num.OGweights, num.OGweights)
    fig, ax = plt.subplots(1, 1, layout = "constrained")
    ax.plot(weight_nums, cum_explained, label = "Cumulative Relative Inverse \u03B1")
    ax.plot([0, num.OGweights], [0.95, 0.95], 'r--', label = "95% threshold")
    ax.plot([k, k], [0, 1], 'g--', label = f"Chosen k = {k}")
    ax.set_ylabel("Cumulative Value")
    ax.set_xlabel("Number of \u03B1's")
    ax.set_ylim([0, 1])
    ax.set_xlim([0, num.OGweights])
    ax.set_xticks(np.arange(0, num.OGweights+1, 1))
    ax.legend()
    plt.show()

if compare_ordered_and_retained == True:
